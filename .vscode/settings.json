{
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",

  // trail-data/ and corpus/local/ hold the sample corpus: ~181k PHP files and ~48k
  // symlinks in an 11 GB tree. They are gitignored, but .gitignore does not stop the
  // editor: VS Code's file indexer runs ripgrep with --no-ignore --follow, so it walks
  // the whole tree AND follows every symlink, and the language servers then try to parse
  // what it finds. Measured on 2026-09-04: one such pass emitted 190 MB of pathnames,
  // took the extension host past 3.8 GB, and exhausted 31 GB of RAM plus 8 GB of swap -
  // the machine had to be restarted. These excludes are what keep that from recurring.
  //
  // watcherExclude stops the file watcher; search.exclude stops quick-open and search;
  // files.exclude keeps them out of the explorer. All three are needed - each covers a
  // different traversal.
  "files.watcherExclude": {
    "**/trail-data/**": true,
    "**/corpus/local/**": true,
    "**/corpus/blobs/**": true,
    "**/corpus/shards/**": true,
    "**/build/**": true,
    "**/build-*/**": true,
    "**/vcpkg_installed/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/trail-data": true,
    "**/corpus/local": true,
    "**/corpus/blobs": true,
    "**/corpus/shards": true,
    "**/build": true,
    "**/build-*": true,
    "**/vcpkg_installed": true
  },
  // The single most important line here. trail-data/incoming/.../incident/ holds 47,855
  // symlinks; with --follow (VS Code's default) ripgrep traverses every one of them and
  // grows an inode set to match. Excludes filter what is REPORTED, not what is WALKED -
  // measured after the excludes were in place, rg still climbed ~2.6 MB/s of RSS past
  // 1 GB while emitting almost nothing. Turning off symlink following stops the walk.
  "search.followSymlinks": false,

  // trail-data/ is deliberately VISIBLE: it is gitignored and holds the corpus and the
  // incident material, and it has to be browsable to work on either. Hiding it in the
  // explorer never protected anything - corpus/pre-push-check.py is what stands between
  // this tree and a push, and it reads what git tracks rather than what the editor shows.
  "files.exclude": {
    "**/vcpkg_installed": true
  },

  // The excludes above cover ripgrep, the watcher and the explorer - none of them cover
  // cpptools, which walks its own tree. With no c_cpp_properties.json its browse.path
  // defaulted to ${workspaceFolder} recursively, so the tag parser walked the same 11 GB
  // and followed the same 47,855 symlinks that ripgrep did. cpptools has no equivalent of
  // search.followSymlinks, so exclusion is the only lever there is. Measured on
  // 2026-09-07: cpptools reached 38.5 GB RSS / 46.9 GB virtual and the kernel OOM-killed
  // it, which broke the WSL user session and put the distro into a restart loop.
  //
  // Kept separate from files.exclude on purpose: that one governs the explorer, and
  // trail-data/ has to stay visible there (see above). build/ is deliberately NOT
  // excluded - compile_commands.json and the generated headers live in it.
  "C_Cpp.files.exclude": {
    "**/trail-data/**": true,
    "**/corpus/**": true,
    "**/vcpkg_installed/**": true,
    "**/build-*/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true
  },

  // The PHP language server would otherwise index every sample in the corpus - live
  // webshells included - which is both enormous and pointless: this is a C++ project.
  "php.problems.enabled": false,
  "php.workspace.includePattern": "",
  "files.associations": {
    "**/trail-data/**": "plaintext"
  }
}
